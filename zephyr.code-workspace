{
	"folders": [
		{
			"name": "Zephyr",
			"path": "zephyr"
		},
		{
			"name": "Modules",
			"path": "modules"
		},
		{
			"name": "BootLoader",
			"path": "bootloader"
		}

	],
	"settings": {
		// Modify these to match installation paths
		"zephyr.zephyr_base": "${workspaceFolder:Zephyr}",
		"zephyr.modules_base": "${workspaceFolder:Modules}",
		"zephyr.zephyr_sdk_install_dir": "/home/<USERNAME>/zephyr-sdk-0.17.0",
		"infineon.openocd_base": "/opt/Tools/ModusToolboxProgtools-1.4/openocd",
		"zephyr.default_board": "cyw920829m2evk_02",
		"zephyr.default_app": "samples/basic/blinky",
		"python.defaultInterpreterPath": "${workspaceFolder:Zephyr}/../../.venv/bin/python",
		"python.terminal.activateEnvironment": true,

		"cortex-debug.armToolchainPath": "${config:zephyr.zephyr_sdk_install_dir}/arm-zephyr-eabi/bin",
		"cortex-debug.gdbPath": "${config:cortex-debug.armToolchainPath}/arm-zephyr-eabi-gdb",
		"cortex-debug.openocdPath": "${config:infineon.openocd_base}/bin/openocd",

		// Hush CMake
		"cmake.configureOnOpen": false,

		// IntelliSense
		"C_Cpp.default.compilerPath": "${config:cortex-debug.armToolchainPath}/arm-zephyr-eabi-gcc",
		"C_Cpp.default.compileCommands": "${workspaceFolder:Zephyr}/build/compile_commands.json",
		"C_Cpp.intelliSenseCachePath": "${workspaceFolder:Zephyr}/../.vscode/cppcache/",

		// File Associations
		"files.associations": {},

		//Formatting Configuration
		"editor.formatOnSave": true,
		"editor.formatOnSaveMode": "modifications",
		"editor.formatOnType": true,
		"editor.formatOnPaste": true,
		"C_Cpp.clang_format_style": "file:/home/<USERNAME>/zephyr/upstream/zephyr/.clang-format",

		//Editor Configuration
		"editor.rulers": [
			100
		],
		"cmake.ignoreCMakeListsMissing": true,
		"cmake.enableAutomaticKitScan": false,
		"cmake.sourceDirectory": "${workspaceFolder:Zephyr}/nonexistent",
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "West Build",
				"type": "shell",
				"group": {
					"kind": "build",
					"isDefault": true
				},
				"command": "west",
				"args": [
					"build",
					"-p",
					"auto",
					"-b",
					"${config:zephyr.default_board}",
					"${config:zephyr.default_app}",
				],
				"problemMatcher": [
					"$gcc"
				]
			},
			{
				"label": "West Configurable Build",
				"type": "shell",
				"group": {
					"kind": "build",
				},
				"command": "west",
				"args": [
					"build",
					"-p",
					"${input:pristine}",
					"-b",
					"${input:board}",
					"${input:app}",
				],
				"problemMatcher": [
					"$gcc"
				]
			},
			{
				"label": "West Flash",
				"type": "shell",
				"command": "west",
				"args": [
					"flash",
					"--openocd",
					"${config:infineon.openocd_base}/bin/openocd"
				],
				"windows": {
					"args": [
						"flash",
						"--openocd",
						"${config:infineon.openocd_base}/bin/openocd.exe"
					],
				},
				"problemMatcher": [
					"$gcc"
				]
			},
			{
				"label": "West Build and Flash",
				"dependsOn": ["West Build", "West Flash"],
				"dependsOrder": "sequence",
				"problemMatcher": ["$gcc"]
			},
			{
				"label": "Erase Flash",
				"type": "shell",
				"command": "west",
				"args": [
					"flash",
					"--cmd-load",
					"'flash erase_address 0x60000000 0x100000;#'",
					"--openocd",
					"${config:infineon.openocd_base}/bin/openocd"
				],
				"windows": {
					"args": [
						"flash",
						"--cmd-load",
						"'flash erase_address 0x60000000 0x100000;#'",
						"--openocd",
						"${config:infineon.openocd_base}/bin/openocd.exe"
					],
				},
				"problemMatcher": []
			}
		],
		"inputs": [
			{
				"id": "board",
				"type": "pickString",
				"default": "cyw920829m2evk_02",
				"description": "Choose target board",
				"options": [
					"cyw920829m2evk_02",
					"cy8ckit_062s2_ai",
					"cy8ckit_062s4",
					"cy8cproto_062_4343w",
					"cy8cproto_063_ble",
					"xmc45_relax_kit",
					"xmc47_relax_kit",
				]
			},
			{
				"id": "pristine",
				"type": "pickString",
				"description": "Choose when to run a pristine build",
				"default": "auto",
				"options": [
					"auto",
					"always",
					"never"
				]
			},
			{
				"id": "app",
				"type": "pickString",
				"default": "samples/hello_world",
				"description": "Choose which application to build",
				"options": [
					"samples/hello_world",
					"samples/basic/blinky",
					"samples/basic/fade_led",
					"samples/basic/blinky_pwm",
				]
			},
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Launch CYW20829 CM33 (KitProg3_MiniProg4)",
				"cwd": "${workspaceFolder:Zephyr}",
				"executable": "build/zephyr/zephyr.elf",
				"request": "launch",
				"type": "cortex-debug",
				"runToEntryPoint": "main",
				"servertype": "openocd",
				"preLaunchTask": "West Build and Flash",
				"rtos": "auto",
				"searchDir": [
					"${config:infineon.openocd_base}/scripts/",
				],
				"openOCDPreConfigLaunchCommands": [
					"set QSPI_FLASHLOADER ${config:zephyr.modules_base}/hal/infineon/mtb-template-cat1/files/flashloader/cat1b/CYW208xx_SMIF.FLM",
				],
				"openOCDLaunchCommands": [
					"${TARGET}.cm33 configure -rtos auto -rtos-wipe-on-reset-halt 1",
					"gdb_breakpoint_override hard"
				],
				"configFiles": [
					"${config:zephyr.zephyr_base}/boards/infineon/cyw920829m2evk_02/support/openocd.cfg"
				],
				"overrideLaunchCommands": [
					"set mem inaccessible-by-default off",
					"-enable-pretty-printing",
					"set remotetimeout 15",
					"monitor reset init",
				],
				"overrideRestartCommands": [
					"starti"
				],
				// svdFile is optional, it can be very large.
				"svdFile": "${config:zephyr.modules_base}/hal/infineon/mtb-pdl-cat1/devices/COMPONENT_CAT1B/svd/cyw20829.svd",
				"breakAfterReset": true,
				"showDevDebugOutput": "none",
			},
			{
				"name": "Attach CYW20829 CM33 (KitProg3_MiniProg4)",
				"cwd": "${workspaceFolder:Zephyr}",
				"executable": "build/zephyr/zephyr.elf",
				"request": "attach",
				"type": "cortex-debug",
				"runToEntryPoint": "main",    // Specifies application entry point name for restart/reset
				"servertype": "openocd",
				"rtos": "auto",
				"searchDir": [
					"${config:zephyr.zephyr_base}/boards/infineon/cyw920829m2evk_02/support/",
					"${config:infineon.openocd_base}/scripts/",
				],
				"openOCDPreConfigLaunchCommands": [
					"set QSPI_FLASHLOADER ${config:zephyr.modules_base}/hal/infineon/mtb-template-cat1/files/flashloader/cat1b/CYW208xx_SMIF.FLM",
				],
				"openOCDLaunchCommands": [
					"${TARGET}.cm33 configure -rtos auto -rtos-wipe-on-reset-halt 1",
					"gdb_breakpoint_override hard"
				],
				"configFiles": [
					"${config:zephyr.zephyr_base}/boards/infineon/cyw920829m2evk_02/support/openocd.cfg"
				],
				"overrideAttachCommands": [
					"set mem inaccessible-by-default off",
					"-enable-pretty-printing",
					"set remotetimeout 15",
					"monitor halt"
				],
				"overrideRestartCommands": [
					"starti"
				],
				// svdFile is optional, it can be very large.
				"svdFile": "${config:zephyr.modules_base}/hal/infineon/mtb-pdl-cat1/devices/COMPONENT_CAT1B/svd/cyw20829.svd",
				"breakAfterReset": true,
				"showDevDebugOutput": "none"
			}
		]
	},
	"extensions": {
		"recommendations": [
			"ms-vscode.cpptools-extension-pack",
			"ms-python.python",
			"ms-vscode.vscode-embedded-tools",
			"ms-vscode.vscode-serial-monitor",
			"marus25.cortex-debug",
		]
	}
}
